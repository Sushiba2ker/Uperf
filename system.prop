# Uperf Sushiba System Properties
# Comprehensive Performance, Latency & Battery Optimizations
# Integrated from Frosty & Uperf Engine

# SurfaceFlinger & Graphics Overhead Suppression
debug.egl.profiler=0
debug.hwc.otf=0
debug.hwc_dump_en=0
debug.sf.dump=0
debug.sf.ddms=0
debug.sf.recomputecrop=0
debug.sf.showupdates=0
debug.sf.showcpu=0
debug.sf.showbackground=0
debug.sf.showfps=0
ro.sf.blurs_are_expensive=0
ro.surface_flinger.supports_background_blur=0
persist.sys.sf.native_mode=1

# Game & Wayland Logging Suppression
debug.enable.gamed=0
debug.enable.wl_log=0

# ANR, Profiler & Tracing Suppression
debugtool.anrhistory=0
debug.atrace.tags.enableflags=0
debug.kill_allocating_task=0
debug_test=0
persist.traced.enable=0

# Logcat & System Logging Suppression
logcat.live=disable
live.logcat=disable
ro.logd.size=0
log.redirect-stdio=false
rw.logger=0

# Media & Codec Debug Logging Suppression
media.stagefright.log-uri=0
vidc.debug.level=0
log.resolves=0
log.pm4=0
log.pm4mem=0
log.shaders=0
log.sc_dev=0
log.cffdump=0
log.cffdump_with_ifh=0
log.cffdump_no_memzero=0
log.dumpx=0
log.primitives=0
log_frame_info=0
log_mp4dectime=0
log_posttime=0
log_profile=0
log_playerdriver=0
log_metadatadriver=0
log_playerengine=0
log_datapath=0
log_mp4parsernode=0
log_basedecnode=0
log_audiodecnode=0
log_videodecnode=0
log_outputnode=0
log_outputnodeinputport=0
log_audiooutput=0
log_surfaceoutput=0
log_omxmp4=0
log_ao=0
log_fps_interval=0

# Profiler & Checkin Telemetry Disable
profiler.debugmonitor=false
profiler.launch=false
profiler.hung.dumpdobugreport=false
ro.config.nocheckin=1
profiler.forse_disable_err_rpt=1
profiler.forse_disable_ulog=1

# StrictMode & Battery Logging Suppression
persist.android.strictmode=0
ro.sf.battery_log=0
ro.sf.battery.log.enabled=0

# Telephony, Radio & IMS Logging Suppression
ro.telephony.call_ring.multiple=false
persist.ims.disableDebugLogs=1
persist.ims.enableADBLogs=0
persist.ims.enableDebugLogs=0
persist.ims.disableQXDMLogs=1
persist.ims.disableIMSLogs=1
persist.debug.wfd.enable=0
persist.sys.wfd.virtual=0
persist.data.qmi.adb_logmask=0
persist.brcm.log=none
persist.brcm.cp_crash=none
persist.brcm.ap_crash=none
persist.sys.dun.override=0
persist.radio.oem_socket=false
persist.oem.dump=0
persist.sys.offlinelog.kernel=0
persist.sys.offlinelog.logcat=0
persist.service.pcsync.enable=0
persist.service.lgospd.enable=0
persist.service.logging.disable=true
persist.vendor.ssr.enable_ramdumps=0

# Memory, Runtime & JNI Checks Suppression
libc.debug.malloc=0
ro.kernel.android.checkjni=0
ro.kernel.checkjni=0
dalvik.vm.checkjni=false

# Modem RIL Power Saving
ro.ril.disable.power.collapse=0
ro.ril.power_collapse=1

# Database & Network Optimization
config.disable_rtt=true
db.log.slow_query_threshold=-1
ro.config.small_battery=true

# MediaTek Compatibility Stubs
ro.mtk_perf_simple_start_win=0
ro.mtk_perf_response_time=0
ro.mtk_perf_fast_start_win=0
